{
  "name": "copilot-builder-web",
  "version": "1.1.0",
  "description": "Interaktivní generátor konfiguračních souborů pro GitHub Copilot (instrukce, agents, skills, prompty).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Matěj Hrabák (https://matejhrabak.cz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crazyka51/Copilot-instructions-builder.git"
  },
  "homepage": "https://github.com/Crazyka51/Copilot-instructions-builder#readme",
  "bugs": {
    "url": "https://github.com/Crazyka51/Copilot-instructions-builder/issues"
  },
  "keywords": [
    "github-copilot",
    "copilot-instructions",
    "agents-md",
    "skills",
    "code-generator",
    "react",
    "typescript",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "lint": "eslint .",
    "extract": "node scripts/extract.mjs && node scripts/to-ts.mjs",
    "parity": "node scripts/parity.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "vendor:ps1": "node scripts/vendor-ps1.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7"
  }
}
